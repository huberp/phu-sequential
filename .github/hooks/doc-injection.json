{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "./scripts/inject-docs.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "./scripts/inject-contextual-docs.sh",
        "cwd": ".",
        "timeoutSec": 15
      }
    ]
  }
}
